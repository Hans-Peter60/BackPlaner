    "Warum meldest Du dieses Rezept? Es wird sofort für alle Nutzer ausgeblendet und anschließend geprüft." : {
      "comment" : "The body of the confirmation dialog that appears when the user reports a recipe.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
