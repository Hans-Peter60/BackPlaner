          }
        }
      }
    },
    "„%@“ beginnt am %@ und damit nach dem Tagesende (%@ Uhr)." : {
      "comment" : "A hint that a baking step starts after the end of the day. The first argument is the step description. The second argument is the step time. The third argument is the string “%02d:00”.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "„%1$@“ beginnt am %2$@ und damit nach dem Tagesende (%3$@ Uhr)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” starts on %2$@, after the end of day (%3$@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » commence le %2$@, soit après la fin de journée (%3$@)."
          }
        }
      }
    },
    "„%@“ beginnt am %@ und damit vor dem Tagesbeginn (%@ Uhr)." : {
      "comment" : "A hint that a step starts before the start of the day. The first argument is the step description. The second argument is the start time of the day. The third argument is the string “%02d:00”.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "„%1$@“ beginnt am %2$@ und damit vor dem Tagesbeginn (%3$@ Uhr)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” starts on %2$@, before the start of day (%3$@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » commence le %2$@, soit avant le début de journée (%3$@)."
          }
        }
      }
    },
    "„%@“ für %@ ist erst %@ fällig. Trotzdem als erledigt markieren?" : {
      "comment" : "Confirmation dialog for the user to mark a step as done. The first argument is the spoken instruction of the step. The second argument is the recipe name. The third argument is the date text for the step.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "„%1$@“ für %2$@ ist erst %3$@ fällig. Trotzdem als erledigt markieren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” for %2$@ is not due until %3$@. Mark it as done anyway?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » pour %2$@ n’est prévu que %3$@. Le marquer quand même comme terminé ?"
          }
        }
      }
    },
    "„%@“ und alle folgenden Schritte von %@ um %lld Minuten nach hinten verschieben?" : {
      "comment" : "Confirmation dialog for postponing a step and all following steps. The first argument is the spoken instruction of the step. The second argument is the recipe name. The third argument is the number of minutes to shift.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "„%1$@“ und alle folgenden Schritte von %2$@ um %3$lld Minuten nach hinten verschieben?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move “%1$@” and all following steps of %2$@ %3$lld minutes later?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retarder « %1$@ » et toutes les étapes suivantes de %2$@ de %3$lld minutes ?"
          }
        }
      }
    },
    "„%@“ und alle folgenden Schritte von %@ um %lld Minuten vorziehen?" : {
      "comment" : "Confirmation dialog for postponing a step and all following steps. The first argument is the spoken instruction of the step. The second argument is the recipe name. The third argument is the number of minutes to shift.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "„%1$@“ und alle folgenden Schritte von %2$@ um %3$lld Minuten vorziehen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move “%1$@” and all following steps of %2$@ %3$lld minutes earlier?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avancer « %1$@ » et toutes les étapes suivantes de %2$@ de %3$lld minutes ?"
          }
        }
      }
    },
    "„%@“ wird als Administrator endgültig aus der öffentlichen Datenbank entfernt." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As an administrator, you’re about to permanently remove “%@” from the public database."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tant qu’administrateur, vous allez supprimer définitivement « %@ » de la base de données publique."
          }
        }
      }
    },
    "„%@“ wird dauerhaft gelöscht." : {
      "localizations" : {
