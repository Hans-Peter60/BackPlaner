    },
    "Einkorn bindet wenig Wasser und ist klebrig: deutlich weniger Wasser, kaum kneten, Kastenform statt freigeschoben." : {
      "comment" : "Text for a hint to use einkorn flour.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Einkorn absorbs little water and is sticky: use noticeably less water, barely knead, and bake in a loaf tin rather than free-standing."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le petit épeautre absorbe peu d’eau et est collant : mettez nettement moins d’eau, pétrissez à peine et cuisez dans un moule plutôt que sur sole."
          }
        }
      }
    },
