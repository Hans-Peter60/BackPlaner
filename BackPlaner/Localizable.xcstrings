    "„%@“ beginnt am %@ und damit nach dem Tagesende (%@ Uhr).": {
      "comment": "A hint that a baking step starts after the end of the day. The first argument is the step description. The second argument is the step time. The third argument is the string “%02d:00”.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "„%1$@“ beginnt am %2$@ und damit nach dem Tagesende (%3$@ Uhr)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” starts on %2$@, after the end of day (%3$@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » commence le %2$@, soit après la fin de journée (%3$@)."
          }
        }
      }
    },
    "„%@“ beginnt am %@ und damit vor dem Tagesbeginn (%@ Uhr).": {
      "comment": "A hint that a step starts before the start of the day. The first argument is the step description. The second argument is the start time of the day. The third argument is the string “%02d:00”.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "„%1$@“ beginnt am %2$@ und damit vor dem Tagesbeginn (%3$@ Uhr)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” starts on %2$@, before the start of day (%3$@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » commence le %2$@, soit avant le début de journée (%3$@)."
          }
        }
      }
    },
    "„%@“ wird dauerhaft gelöscht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" will be permanently deleted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » sera supprimé définitivement."
          }
        }
      }
    },
    "%@, Bewertung %lld von 5 Sternen": {
      "comment": "A label that announces the recipe name and its rating. The first argument is the recipe name. The second argument is the rating. The third argument is the maximum number of stars.",
