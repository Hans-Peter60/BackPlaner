      }
    },
    "%@ früher" : {
      "comment" : "How much earlier a suggested date is, e.g. “1 Std., 45 Min.”.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ earlier"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ plus tôt"
          }
        }
      }
    },
    "%@ später" : {
      "comment" : "How much later a suggested date is, e.g. “1 Std., 45 Min.”.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ later"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ plus tard"
          }
        }
      }
    },
    "%@ · %@ %@" : {
      "comment" : "Next step card: recipe name, day (Heute, Morgen or a date) and time. Only placeholders, nothing to translate.",
      "shouldTranslate" : false
    },
    "%lld Erinnerungen gesetzt.\nBackofen anstellen um %@ Uhr (%@).\nFertig um %@ Uhr." : {
      "comment" : "Summary after reminders were set: number of reminders, time and oven temperature for switching the oven on, finish time.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld Erinnerungen gesetzt.\nBackofen anstellen um %2$@ Uhr (%3$@).\nFertig um %4$@ Uhr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld reminders set.\nTurn on the oven at %2$@ (%3$@).\nDone at %4$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld rappels définis.\nAllumer le four à %2$@ (%3$@).\nTerminé à %4$@."
          }
        }
      }
    },
    "%lld Erinnerungen gesetzt.\nBackofen anstellen um %@ Uhr (%@).\nFertig um %@ Uhr.\n\n%@" : {
      "comment" : "Summary after reminders were set: number of reminders, time and oven temperature for switching the oven on, finish time, and hints about the plan.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld Erinnerungen gesetzt.\nBackofen anstellen um %2$@ Uhr (%3$@).\nFertig um %4$@ Uhr.\n\n%5$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld reminders set.\nTurn on the oven at %2$@ (%3$@).\nDone at %4$@.\n\n%5$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld rappels définis.\nAllumer le four à %2$@ (%3$@).\nTerminé à %4$@.\n\n%5$@"
          }
        }
      }
    },
    "BakePlanner konnte seinen Datenspeicher nicht öffnen und läuft vorübergehend ohne Deine Rezepte, Pläne und Einkaufslisten. Was Du jetzt anlegst, wird nicht gespeichert. Deine Daten bleiben erhalten: Prüfe, ob auf dem Gerät genug Speicher frei ist, und starte die App neu." : {
      "comment" : "Message of the alert shown at launch when the app's data store could not be opened.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BakePlanner could not open its data store and is running without your recipes, plans, and shopping lists for now. Anything you create now will not be saved. Your data is still there: check that the device has enough free storage, and restart the app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BakePlanner n’a pas pu ouvrir sa base de données et fonctionne provisoirement sans vos recettes, plans et listes de courses. Ce que vous créez maintenant ne sera pas enregistré. Vos données sont conservées : vérifiez qu’il reste assez d’espace libre sur l’appareil, puis redémarrez l’app."
          }
        }
      }
    },
    "Beginn %@ · fertig %@" : {
      "comment" : "When the first step begins and when the bake is finished with a suggested date.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beginn %1$@ · fertig %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starts %1$@ · done %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Début %1$@ · fin %2$@"
          }
        }
      }
    },
    "Fertig bis %@" : {
      "comment" : "Suggested date when the plan is read as a finishing time. The argument is weekday, date and time.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Done by %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminé pour %@"
          }
        }
      }
    },
    "Innerhalb eines Tages gibt es keinen Zeitpunkt, zu dem alle Schritte in Deinen Tag fallen." : {
      "comment" : "Shown under the night hints when no date within a day either way keeps every step inside the day window.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Within a day either way, there is no time at which every step falls inside your day."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans un délai d’un jour, aucun horaire ne place toutes les étapes dans votre journée."
          }
        }
      }
    },
    "Komponente nicht mehr vorhanden" : {
      "comment" : "Shown when a component opened for editing has been deleted in the meantime.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Component no longer exists"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce composant n’existe plus"
          }
        }
      }
    },
    "Nicht zugelassen" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not allowed"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non autorisée"
          }
        }
      }
    },
    "Nur lokal" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local only"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local uniquement"
          }
        }
      }
    },
    "Rezepte konnten nicht geladen werden" : {
      "comment" : "Title of the alert shown at launch when the app's data store could not be opened.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recipes could not be loaded"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger les recettes"
          }
        }
      }
    },
    "Sie wurde inzwischen gelöscht, vielleicht auf einem anderen Gerät." : {
      "comment" : "Explains why a component opened for editing no longer exists.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It has been deleted in the meantime, perhaps on another device."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il a été supprimé entre-temps, peut-être sur un autre appareil."
          }
        }
      }
    },
    "So beginnt kein Schritt in der Nacht:" : {
      "comment" : "Heading above the suggested dates at which no step begins outside the day window.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So that no step begins at night:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour qu’aucune étape ne commence la nuit :"
          }
        }
      }
    },
    "Starten ab %@" : {
      "comment" : "Suggested date when the plan is read as a start time. The argument is weekday, date and time.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start from %@"
