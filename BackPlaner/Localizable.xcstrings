    },
    "Die Anmeldung wird für private Cloud-Rezepte benötigt: nur so bleiben sie nach einer Neuinstallation erreichbar. Administratoren verwalten damit gemeldete Rezepte." : {
      "comment" : "A description of the account section of the settings view.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Signing in is required for private cloud recipes: It’s the only way they stay accessible after you reinstall the app. Administrators use it to manage reported recipes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La connexion est nécessaire pour les recettes privées dans le cloud : c’est le seul moyen de les garder accessibles après une réinstallation. Les administrateurs s’en servent pour gérer les recettes signalées."
          }
        }
      }
    },
    "Die App liest die Bilder mit jeder bekannten Vorlage und behält das Ergebnis, das zu den Angaben der Seite passt." : {
      "comment" : "A description of the automatic recipe layout.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "The app reads the images with every known source type and keeps the result that matches the details on the page."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’app lit les images avec chaque type de source connu et conserve le résultat qui correspond aux indications de la page."
          }
        }
      }
    },
    "Die Backzeit (%@) überschneidet sich mit der Backzeit von „%@“ (%@)." : {
      "comment" : "A localized string. The first argument is the string “%1$arg – %2$arg”. The third argument is the string “%1$arg – %2$arg”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Die Backzeit (%1$@) überschneidet sich mit der Backzeit von „%2$@“ (%3$@)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The baking time (%1$@) overlaps with the baking time of “%2$@” (%3$@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le temps de cuisson (%1$@) chevauche le temps de cuisson de « %2$@ » (%3$@)."
          }
        }
      }
    },
    "Die berechnete Teigausbeute (%lld) weicht von der angegebenen (%lld) ab." : {
      "comment" : "A warning that the printed dough yield does not match the computed value.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Die berechnete Teigausbeute (%1$lld) weicht von der angegebenen (%2$lld) ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The calculated dough yield (%1$lld) differs from the specified value (%2$lld)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rendement de la pâte calculé (%1$lld) diffère de celui indiqué (%2$lld)."
          }
        }
      }
    },
    "Die Menge gilt für diese Einkaufsliste. Das Rezept bleibt unverändert." : {
      "comment" : "A description of the effect of changing the amount of a shopping list item.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
