    "Der ausgewählte Schritt wurde nicht gefunden." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected step was not found."
          }
        },
        "fr" : {
          "stringUnit" : {
