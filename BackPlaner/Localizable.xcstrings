          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La somme des ingrédients détectés (%1$lld g) diffère du poids de pâte indiqué (%2$lld g)."
          }
        }
      }
    },
    "Die Umrechnung muss größer als 0 sein." : {
