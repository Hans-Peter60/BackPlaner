            "value" : "Unités personnalisées"
          }
        }
      }
    },
    "Eigene Rezepte" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My recipes"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
