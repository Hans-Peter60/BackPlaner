      }
    },
    "Die Summe der erkannten Zutaten (%lld g) weicht von der angegebenen Teigmenge (%lld g) ab." : {
      "comment" : "Warning message.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
