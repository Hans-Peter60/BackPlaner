        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette recette a été signalée et est masquée pour tous les autres utilisateurs."
          }
        }
      }
    },
    "Du hast noch keine eigene Einheit angelegt. Die mitgelieferten Einheiten stehen in der Auswahlliste immer zur Verfügung." : {
      "comment" : "A description of the custom units view.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
