    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BackPlaner verwendet die Kamera, um Fotos deiner Rezepte und fertigen Backwaren aufzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BackPlaner uses the camera to take photos of your recipes and finished bakes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BackPlaner utilise l’appareil photo pour prendre des photos de vos recettes et de vos préparations terminées."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BackPlaner greift auf deine Fotomediathek zu, damit du Bilder deiner Rezepte und Backwaren hinzufügen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BackPlaner accesses your photo library so you can add pictures of your recipes and bakes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BackPlaner accède à votre photothèque afin que vous puissiez ajouter des images de vos recettes et de vos préparations."
          }
        }
      }
    }
