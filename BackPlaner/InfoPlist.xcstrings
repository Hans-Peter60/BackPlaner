    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "BakePlanner verwendet die Kamera, um Fotos deiner Rezepte und fertigen Backwaren aufzunehmen."
