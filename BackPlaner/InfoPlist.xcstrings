    "NSAlarmKitUsageDescription" : {
      "comment" : "Privacy - AlarmKit Usage Description. The key comes from BackPlaner/Info.plist (merged into the generated one), which Xcode's extraction does not see.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BakePlanner stellt auf Wunsch Wecker für die Schritte Deines Backvorgangs, die auch bei stummgeschaltetem iPhone klingeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BakePlanner sets alarms for the steps of your bake on request, which ring even when the iPhone is on silent."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BakePlanner règle sur demande des alarmes pour les étapes de votre cuisson, qui sonnent même si l’iPhone est en silencieux."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BakePlanner verwendet die Kamera, um Fotos deiner Rezepte und fertigen Backwaren aufzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BakePlanner uses the camera to take photos of your recipes and finished bakes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BakePlanner utilise l’appareil photo pour prendre des photos de vos recettes et de vos préparations terminées."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BakePlanner greift auf deine Fotomediathek zu, damit du Bilder deiner Rezepte und Backwaren hinzufügen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BakePlanner accesses your photo library so you can add pictures of your recipes and bakes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BakePlanner accède à votre photothèque afin que vous puissiez ajouter des images de vos recettes et de vos préparations."
          }
        }
      }
    },
    "NSCalendarsWriteOnlyAccessUsageDescription" : {
      "comment" : "Privacy usage description. The key comes from BackPlaner/Info.plist (merged into the generated one), which Xcode's extraction does not see.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BakePlanner trägt auf Wunsch die Schritte eines Plans in Deinen Kalender ein, damit alle sehen, wann der Ofen belegt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BakePlanner enters the steps of a plan into your calendar on request, so everyone sees when the oven is taken."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BakePlanner inscrit sur demande les étapes d’un plan dans votre calendrier, pour que chacun voie quand le four est occupé."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription" : {
      "comment" : "Privacy usage description. The key comes from BackPlaner/Info.plist (merged into the generated one), which Xcode's extraction does not see.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BakePlanner schickt auf Wunsch eine Einkaufsliste in die Erinnerungen, in eine eigene Liste „BakePlanner“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BakePlanner sends a shopping list to Reminders on request, into its own list “BakePlanner”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BakePlanner envoie sur demande une liste de courses dans Rappels, dans sa propre liste « BakePlanner »."
          }
        }
      }
    }
  },
  "version" : "1.3"
}