rules_version = '2';

// Firestore security rules for BackPlaner's public recipe database.
//
// These rules require Firebase Anonymous Authentication to be enabled
// (Firebase console → Authentication → Sign-in method → Anonymous) and the app
// to sign in anonymously and use `auth.uid` as the recipe `authorId`. Without a
// server-verified identity, "only the author may edit/delete" cannot be
// enforced — see firebase/README.md.
//
// Combine with App Check (already a dependency) to ensure requests originate
// from the genuine app.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers --------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // A moderator/owner: their uid has a document in the `admins` collection.
    // Admins may delete any public recipe (App Store Guideline 1.2 moderation).
    function isAdmin() {
      return isSignedIn()
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // A recipe must carry a non-empty name and be stamped with the caller's
    // own uid as authorId, so ownership checks below are trustworthy.
    function isValidRecipe(data) {
      return data.keys().hasAll(['name', 'authorId'])
          && data.name is string
          && data.name.size() > 0
          && data.name.size() <= 200
          && data.authorId is string
          && data.authorId == request.auth.uid;
    }

    // ---- Public recipe database ----------------------------------------

    match /Recipe/{recipeId} {

      // Anyone using the genuine app (App Check) may browse recipes.
      allow read: if isSignedIn();

      // Only signed-in devices may publish, stamping their own uid.
      allow create: if isSignedIn() && isValidRecipe(request.resource.data);

      // Only the original author may modify their recipe, and may not hand it
      // to a different author. `.get()` avoids erroring on legacy recipes that
      // have no authorId field.
      allow update: if isSignedIn()
                    && resource.data.get('authorId', '') == request.auth.uid
                    && request.resource.data.authorId == request.auth.uid;

      // The original author or an admin may delete a recipe. Check isAdmin()
      // FIRST so admins are never blocked by a legacy recipe whose authorId
      // field is missing or non-string: accessing an absent field would error
      // and deny the whole rule before isAdmin() is ever evaluated. `.get()`
      // makes the author comparison safe for the same reason.
      allow delete: if isSignedIn()
                    && (isAdmin()
                        || resource.data.get('authorId', '') == request.auth.uid);

      // Subcollections belong to the recipe: everyone signed in may read,
      // the recipe's author or an admin may write (needed for admin deletion).
      // isAdmin() is checked first for the same reason as delete above.
      function canWriteRecipeChildren() {
        return isAdmin()
            || (isSignedIn()
             && get(/databases/$(database)/documents/Recipe/$(recipeId)).data.get('authorId', '') == request.auth.uid);
      }

      match /components/{componentId} {
        allow read:  if isSignedIn();
        allow write: if canWriteRecipeChildren();

        match /ingredients/{ingredientId} {
          allow read:  if isSignedIn();
          allow write: if canWriteRecipeChildren();
        }
      }

      match /instructions/{instructionId} {
        allow read:  if isSignedIn();
        allow write: if canWriteRecipeChildren();
      }
    }

    // ---- Admin / moderator registry ------------------------------------
    // Membership is managed ONLY from the Firebase console. A signed-in user may
    // read their OWN admin document so the app can enable the moderation UI; no
    // client may ever write here.
    match /admins/{adminId} {
      allow read:  if isSignedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    // ---- Moderation reports (App Store Guideline 1.2) -------------------

    match /reports/{reportId} {
      // Users may file reports; they carry their own uid as reporter.
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasAll(['recipeId', 'reason', 'reportedBy'])
                    && request.resource.data.reportedBy == request.auth.uid;

      // Reports are reviewed only in the Firebase console, never from clients.
      allow read, update, delete: if false;
    }
  }
}
