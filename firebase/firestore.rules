rules_version = '2';

// Firestore security rules for BackPlaner's public recipe database.
//
// These rules require Firebase Anonymous Authentication to be enabled
// (Firebase console → Authentication → Sign-in method → Anonymous) and the app
// to sign in anonymously and use `auth.uid` as the recipe `authorId`. Without a
// server-verified identity, "only the author may edit/delete" cannot be
// enforced — see firebase/README.md.
//
// Combine with App Check (already a dependency) to ensure requests originate
// from the genuine app.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers --------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // A moderator/owner: their uid has a document in the `admins` collection.
    // Admins may delete any public recipe (App Store Guideline 1.2 moderation).
    function isAdmin() {
      return isSignedIn()
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // A recipe must carry a non-empty name and be stamped with the caller's
    // own uid as authorId, so ownership checks below are trustworthy.
    function isValidRecipe(data) {
      return data.keys().hasAll(['name', 'authorId'])
          && data.name is string
          && data.name.size() > 0
          && data.name.size() <= 200
          && data.authorId is string
          && data.authorId == request.auth.uid;
    }

    // A report taking a recipe down: any signed-in user may set `hidden`, but
    // ONLY to true (never to unhide) and without touching any other field. That
    // makes a takedown immediate for everyone; releasing the recipe again is an
    // admin-only operation via the isAdmin() branch.
    //
    // Keep this to the single field: the app writes exactly `{hidden: true}` and
    // no Firestore sentinels, so this condition can be reproduced 1:1 in the
    // Rules Playground.
    function isReportHideUpdate() {
      return request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['hidden'])
          && request.resource.data.hidden == true;
    }

    // ---- Public recipe database ----------------------------------------

    match /Recipe/{recipeId} {

      // Anyone using the genuine app (App Check) may browse recipes.
      allow read: if isSignedIn();

      // Only signed-in devices may publish, stamping their own uid.
      allow create: if isSignedIn() && isValidRecipe(request.resource.data);

      // Three ways a recipe may be updated. isAdmin() is checked FIRST for the
      // same reason as in delete below (a legacy recipe without authorId would
      // otherwise error out the whole rule). `.get()` makes the author
      // comparison safe for the same reason.
      //   1. an admin, who reviews reported recipes and can release them again
      //   2. any reporter, but only to hide the recipe (see isReportHideUpdate)
      //   3. the original author, who may not hand the recipe to someone else
      allow update: if isSignedIn()
                    && (isAdmin()
                        || isReportHideUpdate()
                        || (resource.data.get('authorId', '') == request.auth.uid
                            && request.resource.data.authorId == request.auth.uid));

      // The original author or an admin may delete a recipe. Check isAdmin()
      // FIRST so admins are never blocked by a legacy recipe whose authorId
      // field is missing or non-string: accessing an absent field would error
      // and deny the whole rule before isAdmin() is ever evaluated. `.get()`
      // makes the author comparison safe for the same reason.
      allow delete: if isSignedIn()
                    && (isAdmin()
                        || resource.data.get('authorId', '') == request.auth.uid);

      // Subcollections belong to the recipe: everyone signed in may read,
      // the recipe's author or an admin may write (needed for admin deletion).
      // isAdmin() is checked first for the same reason as delete above.
      function canWriteRecipeChildren() {
        return isAdmin()
            || (isSignedIn()
             && get(/databases/$(database)/documents/Recipe/$(recipeId)).data.get('authorId', '') == request.auth.uid);
      }

      match /components/{componentId} {
        allow read:  if isSignedIn();
        allow write: if canWriteRecipeChildren();

        match /ingredients/{ingredientId} {
          allow read:  if isSignedIn();
          allow write: if canWriteRecipeChildren();
        }
      }

      match /instructions/{instructionId} {
        allow read:  if isSignedIn();
        allow write: if canWriteRecipeChildren();
      }
    }

    // ---- Author-only recipes -------------------------------------------
    // A recipe whose copyright does not allow publishing, kept in the cloud for
    // its author alone. Deliberately a SEPARATE collection instead of a flag in
    // `Recipe`: a Firestore query has to be provably allowed for every document
    // it may return, so a mixed collection would leak nothing but would make
    // every listing depend on document data. Here the whole collection is
    // owner-scoped, and the app queries it with `authorId == uid`.
    //
    // Ownership is bound to a PERMANENT account (Sign in with Apple). An
    // anonymous uid disappears with the app, which would lock the author out of
    // his own recipes for good — so anonymous users may not create any.
    match /PrivateRecipe/{recipeId} {

      function isOwner() {
        return isSignedIn()
            && resource.data.get('authorId', '') == request.auth.uid;
      }

      function hasPermanentAccount() {
        return isSignedIn()
            && request.auth.token.firebase.sign_in_provider != 'anonymous';
      }

      // Reading (single document and listing) is restricted to the owner. The
      // app's query filters on authorId, which satisfies this for a listing.
      allow read: if isOwner();

      allow create: if hasPermanentAccount()
                    && isValidRecipe(request.resource.data);

      // The author may edit his own recipe but never hand it to someone else.
      allow update: if isOwner()
                    && request.resource.data.authorId == request.auth.uid;

      allow delete: if isOwner();

      // Subcollections follow the recipe: only its owner may read or write.
      // Unlike the public recipes there is no admin branch — private content is
      // not shared, so there is nothing to moderate.
      function ownsRecipe() {
        return isSignedIn()
            && get(/databases/$(database)/documents/PrivateRecipe/$(recipeId)).data.get('authorId', '') == request.auth.uid;
      }

      match /components/{componentId} {
        allow read, write: if ownsRecipe();

        match /ingredients/{ingredientId} {
          allow read, write: if ownsRecipe();
        }
      }

      match /instructions/{instructionId} {
        allow read, write: if ownsRecipe();
      }
    }

    // ---- Admin / moderator registry ------------------------------------
    // Membership is managed ONLY from the Firebase console. A signed-in user may
    // read their OWN admin document so the app can enable the moderation UI; no
    // client may ever write here.
    match /admins/{adminId} {
      allow read:  if isSignedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    // ---- Moderation reports (App Store Guideline 1.2) -------------------

    // The app writes these with the deterministic id `{recipeId}_{uid}`. Since
    // only `create` is allowed, a user can report a given recipe exactly once:
    // a second attempt hits an existing document and is denied as an update.
    match /reports/{reportId} {
      // Users may file reports; they carry their own uid as reporter.
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasAll(['recipeId', 'reason', 'reportedBy'])
                    && request.resource.data.reportedBy == request.auth.uid;

      // Reports are reviewed only in the Firebase console, never from clients.
      // (The takedown itself does not depend on this: reporting already sets
      // `hidden` on the recipe, so the content is gone for everyone at once.)
      allow read, update, delete: if false;
    }
  }
}
