rules_version = '2';

// Firestore security rules for BackPlaner's public recipe database.
//
// These rules require Firebase Anonymous Authentication to be enabled
// (Firebase console → Authentication → Sign-in method → Anonymous) and the app
// to sign in anonymously and use `auth.uid` as the recipe `authorId`. Without a
// server-verified identity, "only the author may edit/delete" cannot be
// enforced — see firebase/README.md.
//
// Combine with App Check (already a dependency) to ensure requests originate
// from the genuine app.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers --------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // A moderator/owner: their uid has a document in the `admins` collection.
    // Admins may delete any public recipe (App Store Guideline 1.2 moderation).
    function isAdmin() {
      return isSignedIn()
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // A recipe must carry a non-empty name and be stamped with the caller's
    // own uid as authorId, so ownership checks below are trustworthy.
    function isValidRecipe(data) {
      return data.keys().hasAll(['name', 'authorId'])
          && data.name is string
          && data.name.size() > 0
          && data.name.size() <= 200
          && data.authorId is string
          && data.authorId == request.auth.uid;
    }

    // ---- Numbers --------------------------------------------------------
    // The apps read every number into a plausible range (Plausible in
    // BakePlannerCore), but a public document is written by any author and
    // shown to everyone: a weight of NaN or a step of 10^18 minutes used to
    // crash every app that opened the recipe. So a number may be left out,
    // but when it is there it is a finite number within the same ranges:
    // minutes up to 60 days, grams up to a tonne, temperatures -50…900.
    // NaN fails every comparison, infinity the upper bound.
    function inRange(data, key, low, high) {
      return !(key in data)
          || (data[key] is number && data[key] >= low && data[key] <= high);
    }

    function hasPlausibleRecipeNumbers(data) {
      return inRange(data, 'prepTime', 0, 86400)
          && inRange(data, 'totalWeight', 0, 1000000);
    }

    function isPlausibleIngredient(data) {
      return inRange(data, 'number', 0, 10000)
          && inRange(data, 'weight', 0, 1000000)
          && inRange(data, 'normWeight', 0, 1000000)
          && inRange(data, 'num', 0, 1000)
          && inRange(data, 'denom', 0, 1000);
    }

    function isPlausibleInstruction(data) {
      return inRange(data, 'step', 0, 999)
          && inRange(data, 'duration', 0, 86400)
          && inRange(data, 'startTime', 0, 864000)
          && inRange(data, 'minDuration', 0, 86400)
          && inRange(data, 'maxDuration', 0, 86400)
          && inRange(data, 'ovenTemperature', -50, 900)
          && inRange(data, 'ovenFallingTemperature', -50, 900);
    }

    function isPlausibleComponent(data) {
      return inRange(data, 'number', 0, 10000);
    }

    // A report taking a recipe down: any signed-in user may set `hidden`, but
    // ONLY to true (never to unhide) and without touching any other field. That
    // makes a takedown immediate for everyone; releasing the recipe again is an
    // admin-only operation via the isAdmin() branch.
    //
    // Keep this to the single field: the app writes exactly `{hidden: true}` and
    // no Firestore sentinels, so this condition can be reproduced 1:1 in the
    // Rules Playground.
    function isReportHideUpdate() {
      return request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['hidden'])
          && request.resource.data.hidden == true;
    }

    // Who may see a public recipe: everyone while it is not hidden; once it
    // has been reported, only admins (who review it) and its own author.
    // `recipe` is the recipe document's data.
    //
    // The first operand reads `hidden` directly, not with .get(): a list query
    // has to prove it returns only allowed documents, and the app's
    // `where hidden == false` proves exactly this comparison. Every public
    // recipe therefore has to carry the field (scripts/backfill-hidden.mjs for
    // old ones, the create rule below for new ones). On a document without it
    // the operand errors, and the admin and author checks still decide.
    function canSeeRecipe(recipe) {
      return recipe.hidden == false
          || isAdmin()
          || recipe.get('authorId', '') == request.auth.uid;
    }

    // ---- Public recipe database ----------------------------------------

    match /Recipe/{recipeId} {

      // Anyone using the genuine app (App Check) may browse recipes, except
      // the reported ones (see canSeeRecipe). A listing must therefore filter
      // on `hidden == false` unless the caller is an admin.
      allow read: if isSignedIn() && canSeeRecipe(resource.data);

      // Only signed-in devices may publish, stamping their own uid. A new
      // recipe starts visible and has to say so, or the listing query, which
      // never matches a missing field, would not find it.
      allow create: if isSignedIn()
                    && isValidRecipe(request.resource.data)
                    && hasPlausibleRecipeNumbers(request.resource.data)
                    && request.resource.data.hidden == false;

      // Three ways a recipe may be updated. isAdmin() is checked FIRST for the
      // same reason as in delete below (a legacy recipe without authorId would
      // otherwise error out the whole rule). `.get()` makes the author
      // comparison safe for the same reason.
      //   1. an admin, who reviews reported recipes and can release them again
      //   2. any reporter, but only to hide the recipe (see isReportHideUpdate)
      //   3. the original author, who may not hand the recipe to someone else
      //      and may not release his own recipe after it has been reported,
      //      and whose numbers must be plausible (a report or an admin is not
      //      held to them, so an old recipe with absurd numbers can still be
      //      taken down)
      allow update: if isSignedIn()
                    && (isAdmin()
                        || isReportHideUpdate()
                        || (resource.data.get('authorId', '') == request.auth.uid
                            && request.resource.data.authorId == request.auth.uid
                            && hasPlausibleRecipeNumbers(request.resource.data)
                            && request.resource.data.get('hidden', false)
                                   == resource.data.get('hidden', false)));

      // The original author or an admin may delete a recipe. Check isAdmin()
      // FIRST so admins are never blocked by a legacy recipe whose authorId
      // field is missing or non-string: accessing an absent field would error
      // and deny the whole rule before isAdmin() is ever evaluated. `.get()`
      // makes the author comparison safe for the same reason.
      allow delete: if isSignedIn()
                    && (isAdmin()
                        || resource.data.get('authorId', '') == request.auth.uid);

      // Subcollections belong to the recipe: whoever may see the recipe may
      // read them, so a reported recipe's ingredients and steps are withheld
      // too. The recipe's author or an admin may write (needed for admin
      // deletion). isAdmin() is checked first for the same reason as delete
      // above.
      function canReadRecipeChildren() {
        return isSignedIn()
            && canSeeRecipe(get(/databases/$(database)/documents/Recipe/$(recipeId)).data);
      }

      function canWriteRecipeChildren() {
        return isAdmin()
            || (isSignedIn()
             && get(/databases/$(database)/documents/Recipe/$(recipeId)).data.get('authorId', '') == request.auth.uid);
      }

      // What is written must have plausible numbers (see inRange); an
      // admin is not held to them, and deleting never is.
      match /components/{componentId} {
        allow read:   if canReadRecipeChildren();
        allow create, update: if canWriteRecipeChildren()
                              && (isAdmin() || isPlausibleComponent(request.resource.data));
        allow delete: if canWriteRecipeChildren();

        match /ingredients/{ingredientId} {
          allow read:   if canReadRecipeChildren();
          allow create, update: if canWriteRecipeChildren()
                                && (isAdmin() || isPlausibleIngredient(request.resource.data));
          allow delete: if canWriteRecipeChildren();
        }
      }

      match /instructions/{instructionId} {
        allow read:   if canReadRecipeChildren();
        allow create, update: if canWriteRecipeChildren()
                              && (isAdmin() || isPlausibleInstruction(request.resource.data));
        allow delete: if canWriteRecipeChildren();
      }
    }

    // ---- Retired: author-only recipes ----------------------------------
    // While version 2.0 was being developed, a recipe could be kept in the
    // cloud for its author alone, in the collection `PrivateRecipe` (images
    // under privateImages/); the storage was removed before 2.0 shipped.
    // The app no longer reads or writes it; the documents that are still
    // there are unreachable for every client until they are removed from the
    // console. No rule for the collection means every access is denied.

    // ---- Admin / moderator registry ------------------------------------
    // Membership is managed ONLY from the Firebase console. A signed-in user may
    // read their OWN admin document so the app can enable the moderation UI; no
    // client may ever write here.
    match /admins/{adminId} {
      allow read:  if isSignedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    // ---- Remote configuration ------------------------------------------
    // `config/monetization` holds the switches of the Pro purchase (see
    // Utilities/MonetizationConfig.swift and firebase/README.md). Written
    // ONLY from the Firebase console; every signed-in app reads it. The
    // Functions read it with the Admin SDK, which bypasses these rules.
    match /config/{document} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    // ---- Moderation reports (App Store Guideline 1.2) -------------------

    // The app writes these with the deterministic id `{recipeId}_{uid}`. Since
    // only `create` is allowed, a user can report a given recipe exactly once:
    // a second attempt hits an existing document and is denied as an update.
    match /reports/{reportId} {
      // Users may file reports; they carry their own uid as reporter.
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasAll(['recipeId', 'reason', 'reportedBy'])
                    && request.resource.data.reportedBy == request.auth.uid;

      // Reports are reviewed only in the Firebase console, never from clients.
      // (The takedown itself does not depend on this: reporting already sets
      // `hidden` on the recipe, and the Recipe read rule withholds it from
      // everyone but admins and its author at once.)
      allow read, update, delete: if false;
    }
  }
}
