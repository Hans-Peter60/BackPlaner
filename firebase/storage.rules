rules_version = '2';

// Cloud Storage security rules for BackPlaner's public recipe images.
//
// Like the Firestore rules, these require Firebase Anonymous Authentication so
// that only genuine app users can read/write, and cap upload size and type.
// Per-object author ownership is not tracked in Storage, so any signed-in user
// may delete an image path; the authoritative record is the Firestore recipe.

service firebase.storage {
  match /b/{bucket}/o {

    // Recipe images live under images/<uuid>.jpg
    match /images/{imageId} {
      allow read: if request.auth != null;

      // Uploads must be reasonably sized images.
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null;
    }

    // Deny everything outside the images folder.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
