rules_version = '2';

// Cloud Storage security rules for BackPlaner's public recipe images.
//
// Like the Firestore rules, these require Firebase Anonymous Authentication so
// that only genuine app users can read/write, and cap upload size and type.
// Ownership is expressed through the path: an image lives under the uid of the
// user who uploaded it, so the rules can restrict writes to its author. Images
// of author-only recipes additionally restrict READING to that same user.

service firebase.storage {
  match /b/{bucket}/o {

    function isImageUpload() {
      return request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }

    // A moderator: the caller's uid has a document in the Firestore `admins`
    // collection — the same registry the Firestore rules use. Storage rules
    // can consult Firestore through cross-service rules, which is what lets an
    // admin who deletes a public recipe take its image along instead of
    // leaving it orphaned. Deploying this needs the Storage service agent to
    // hold the Firestore read role. The CLI grants it only on an interactive
    // (or --force) deploy whose rules content actually changed; with
    // --non-interactive it silently skips the check.
    function isAdmin() {
      return request.auth != null
          && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Images of public recipes. Legacy objects live directly under
    // images/<uuid>.jpg, current uploads under images/<uid>/<uuid>.jpg — the
    // owner segment lets the rules below restrict writes to the author.
    match /images/{imageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isImageUpload();
      allow delete: if request.auth != null;
    }

    match /images/{ownerUid}/{imageId} {
      // Public recipes are visible to everyone, so their images are too.
      allow read: if request.auth != null;

      // Only the author may add his own images. Removing one is allowed to the
      // author or to an admin deleting the recipe. The owner check comes first
      // so the common case never costs a Firestore lookup.
      allow write:  if request.auth != null && request.auth.uid == ownerUid && isImageUpload();
      allow delete: if request.auth != null && (request.auth.uid == ownerUid || isAdmin());
    }

    // Images of author-only recipes. A separate folder so the path itself
    // carries who may see the image; no admin branch, private content is not
    // moderated.
    match /privateImages/{ownerUid}/{imageId} {
      allow read:   if request.auth != null && request.auth.uid == ownerUid;
      allow write:  if request.auth != null && request.auth.uid == ownerUid && isImageUpload();
      allow delete: if request.auth != null && request.auth.uid == ownerUid;
    }

    // Deny everything outside the images folder.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
