            "state" : "translated",
            "value" : "Own"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personnels"
          }
        }
      }
    },
    "Eigene Gerichte sichern" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eigene Gerichte sichern"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back up own dishes"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauvegarder mes plats"
          }
        }
      }
    },
    "Eigene Gerichte, Kochprotokolle und Fotos gleichen sich über iCloud zwischen allen Geräten mit derselben Apple-ID ab. Die Einstellungen bleiben je Gerät." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eigene Gerichte, Kochprotokolle und Fotos gleichen sich über iCloud zwischen allen Geräten mit derselben Apple-ID ab. Die Einstellungen bleiben je Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your own dishes, cooking records and photos sync through iCloud between all devices with the same Apple ID. The settings stay per device."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos plats, relevés de cuisson et photos se synchronisent via iCloud entre tous les appareils avec le même identifiant Apple. Les réglages restent propres à chaque appareil."
          }
        }
      }
    },
    "Ein Foto hängst Du im Eintrag unter „Wie war’s?“ an." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Foto hängst Du im Eintrag unter „Wie war’s?“ an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a photo in the entry under “How was it?”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez une photo dans l’entrée sous « C’était comment ? »."
          }
        }
      }
    },
    "Ein Gericht, eine Person, %lld Minuten" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Gericht, eine Person, %lld Minuten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One dish, one cook, %lld minutes"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un plat, une personne, %lld minutes"
          }
        }
      }
    },
    "Ein Handschritt zählt ab dem vorigen Abhaken – oder ab der Minute, für die der Plan ihn vorsah, wenn die später lag – bis zu seinem eigenen. Schritte mit Uhr-Symbol liefen von allein und endeten nach Plan." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Handschritt zählt ab dem vorigen Abhaken – oder ab der Minute, für die der Plan ihn vorsah, wenn die später lag – bis zu seinem eigenen. Schritte mit Uhr-Symbol liefen von allein und endeten nach Plan."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hands-on step counts from the previous tick — or from the minute the plan had it begin, if that was later — to its own. Steps with a timer symbol ran on their own and ended as planned."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une étape manuelle compte depuis la coche précédente — ou depuis la minute prévue par le plan, si elle était plus tardive — jusqu’à la sienne. Les étapes avec le symbole minuteur se sont déroulées seules et ont fini comme prévu."
          }
        }
      }
    },
    "Ein Kochbuch oder ein Zettel: Der Text wird auf dem iPhone erkannt und erscheint im Feld, wo Du ihn prüfen kannst. Die Fotos verlassen das Gerät nicht." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Kochbuch oder ein Zettel: Der Text wird auf dem iPhone erkannt und erscheint im Feld, wo Du ihn prüfen kannst. Die Fotos verlassen das Gerät nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cookbook or a note: the text is recognized on the iPhone and appears in the field, where you can check it. The photos do not leave the device."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un livre de cuisine ou une fiche : le texte est reconnu sur l’iPhone et apparaît dans le champ, où vous pouvez le vérifier. Les photos ne quittent pas l’appareil."
          }
        }
      }
    },
    "Ein neuer Schritt folgt dem vorherigen Schritt seiner Komponente, bis Du die Auswahl änderst. Das Anrichten wartet auf den letzten Schritt jeder Komponente." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein neuer Schritt folgt dem vorherigen Schritt seiner Komponente, bis Du die Auswahl änderst. Das Anrichten wartet auf den letzten Schritt jeder Komponente."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new step follows its component’s previous step until you change the choice. Plating waits for the last step of every component."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une nouvelle étape suit l’étape précédente de son composant jusqu’à ce que vous changiez le choix. Le dressage attend la dernière étape de chaque composant."
          }
        }
      }
    },
