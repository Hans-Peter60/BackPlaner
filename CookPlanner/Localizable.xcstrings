    "Ohne Angabe folgt ein Schritt dem vorherigen Schritt seiner Komponente; der letzte Schritt wartet auf alle Komponenten.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Angabe folgt ein Schritt dem vorherigen Schritt seiner Komponente; der letzte Schritt wartet auf alle Komponenten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without one, a step follows its component’s previous step; the last step waits for every component."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans indication, une étape suit l’étape précédente de son composant ; la dernière étape attend tous les composants."
          }
        }
      }
    },
