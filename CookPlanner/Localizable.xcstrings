    "Der Plan geht nicht auf: Ein Schritt wartet auf sich selbst, oder ein Gerät fehlt in der Küche.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Plan geht nicht auf: Ein Schritt wartet auf sich selbst, oder ein Gerät fehlt in der Küche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plan does not work out: a step waits for itself, or the kitchen lacks a station."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plan ne tient pas : une étape s’attend elle-même, ou un poste manque dans la cuisine."
          }
        }
      }
    },
    "Die Handarbeit allein dauert %lld Minuten. Eine Person reicht nicht: Schritte streichen oder vereinfachen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Handarbeit allein dauert %lld Minuten. Eine Person reicht nicht: Schritte streichen oder vereinfachen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hands-on work alone takes %lld minutes. One pair of hands is not enough: drop or simplify steps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le travail manuel seul prend %lld minutes. Une seule personne ne suffit pas : supprimez ou simplifiez des étapes."
          }
        }
      }
    },
    "Die längste Kette dauert %lld Minuten. Parallel arbeiten hilft nicht, nur kürzere Schritte.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die längste Kette dauert %lld Minuten. Parallel arbeiten hilft nicht, nur kürzere Schritte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The longest chain takes %lld minutes. Working in parallel does not help, only shorter steps do."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La chaîne la plus longue dure %lld minutes. Travailler en parallèle n’aide pas, seules des étapes plus courtes le font."
          }
        }
      }
    },
    "Die Öfen sind vorgeheizt, wenn die Uhr startet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Öfen sind vorgeheizt, wenn die Uhr startet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ovens are preheated when the clock starts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fours sont préchauffés quand le chrono démarre."
          }
        }
      }
    },
