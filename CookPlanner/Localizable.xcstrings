    "Der Plan geht nicht auf: Ein Schritt wartet auf sich selbst, oder ein Gerät fehlt in der Küche." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Plan geht nicht auf: Ein Schritt wartet auf sich selbst, oder ein Gerät fehlt in der Küche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The plan does not work out: a step waits for itself, or the kitchen lacks a station."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plan ne tient pas : une étape s’attend elle-même, ou un poste manque dans la cuisine."
          }
        }
      }
    },
    "Der Text wird zur Analyse an einen Dienst von Google gesendet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Text wird zur Analyse an einen Dienst von Google gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The text is sent to a Google service for analysis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le texte est envoyé à un service Google pour analyse."
          }
        }
      }
    },
    "Die Antwort der Analyse war unvollständig." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Antwort der Analyse war unvollständig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The analysis returned an incomplete answer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La réponse de l’analyse était incomplète."
          }
        }
      }
    },
    "Die Handarbeit allein dauert %lld Minuten. Eine Person reicht nicht: Schritte streichen oder vereinfachen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Handarbeit allein dauert %lld Minuten. Eine Person reicht nicht: Schritte streichen oder vereinfachen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hands-on work alone takes %lld minutes. One pair of hands is not enough: drop or simplify steps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le travail manuel seul prend %lld minutes. Une seule personne ne suffit pas : supprimez ou simplifiez des étapes."
          }
        }
      }
    },
    "Die Schritte öffnen sich im Editor; gespeichert wird erst mit „Sichern“." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schritte öffnen sich im Editor; gespeichert wird erst mit „Sichern“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The steps open in the editor; nothing is saved until “Sichern”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les étapes s’ouvrent dans l’éditeur ; rien n’est enregistré avant « Enregistrer »."
          }
        }
      }
    },
    "Die Seite wird auf diesem Gerät geladen; nur der Rezepttext geht zur Analyse an einen Dienst von Google." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Seite wird auf diesem Gerät geladen; nur der Rezepttext geht zur Analyse an einen Dienst von Google."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The page is loaded on this device; only the recipe text goes to a Google service for analysis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La page est chargée sur cet appareil ; seul le texte de la recette est envoyé à un service de Google pour l’analyse."
          }
        }
      }
    },
    "Die Zeit ist um" : {
