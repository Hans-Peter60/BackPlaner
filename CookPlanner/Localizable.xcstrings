    "0 Minuten für Wenden nach dem Anbraten, 3 für geruhtes Fleisch, 10 für eine warm gestellte Sauce.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "0 Minuten für Wenden nach dem Anbraten, 3 für geruhtes Fleisch, 10 für eine warm gestellte Sauce."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0 minutes for turning after searing, 3 for rested meat, 10 for a sauce kept warm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "0 minute pour retourner après la saisie, 3 pour une viande reposée, 10 pour une sauce tenue au chaud."
          }
        }
      }
    },
