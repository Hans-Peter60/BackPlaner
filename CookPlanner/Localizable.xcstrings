    "Danach allein: %lld Min." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danach allein: %lld Min."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Then on its own: %lld min"
          }
        },
