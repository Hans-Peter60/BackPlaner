            "value" : "Les temps restent les mêmes"
          }
        }
      }
    },
    "Die gewählten Filter erscheinen als eigene Sammlung in der Leiste." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gewählten Filter erscheinen als eigene Sammlung in der Leiste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The chosen filters appear as a collection of your own in the bar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les filtres choisis apparaissent comme votre propre collection dans la barre."
          }
        }
      }
    },
    "Die kostenlosen Importe dieses Monats sind aufgebraucht." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die kostenlosen Importe dieses Monats sind aufgebraucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This month’s free imports are used up."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les imports gratuits de ce mois sont épuisés."
          }
        }
      }
    },
    "Die letzten zwölf Monate" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die letzten zwölf Monate"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The last twelve months"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les douze derniers mois"
          }
        }
      }
    },
    "Die längste Kette dauert %lld Minuten. Parallel arbeiten hilft nicht, nur kürzere Schritte." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die längste Kette dauert %lld Minuten. Parallel arbeiten hilft nicht, nur kürzere Schritte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The longest chain takes %lld minutes. Working in parallel does not help, only shorter steps do."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chaîne la plus longue dure %lld minutes. Travailler en parallèle n’aide pas, seules des étapes plus courtes le font."
          }
        }
      }
    },
    "Die Öfen sind vorgeheizt, wenn die Uhr startet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Öfen sind vorgeheizt, wenn die Uhr startet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The ovens are preheated when the clock starts."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fours sont préchauffés quand le chrono démarre."
          }
        }
      }
    },
    "Eigene" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eigene"
          }
        },
        "en" : {
