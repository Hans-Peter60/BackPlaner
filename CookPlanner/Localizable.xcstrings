    "%lld Minuten Luft, %lld Minuten ohne Handarbeit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Minuten Luft, %lld Minuten ohne Handarbeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld minutes to spare, %lld minutes without hands-on work."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld minutes de marge, %lld minutes sans travail manuel."
          }
        }
      }
    },
