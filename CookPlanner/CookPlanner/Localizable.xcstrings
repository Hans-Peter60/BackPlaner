          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gericht des laufenden Kochvorgangs gibt es nicht mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The dish of the run under way no longer exists."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plat de la session en cours n’existe plus."
