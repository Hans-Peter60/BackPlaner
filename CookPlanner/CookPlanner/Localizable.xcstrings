    },
    "Das Protokoll hält fest, wann jeder Schritt erledigt war." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Protokoll hält fest, wann jeder Schritt erledigt war."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The record keeps when each step was done."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le relevé garde le moment où chaque étape a été terminée."
          }
        }
      }
    },
    "Das stündliche Analyse-Limit ist erreicht. Bitte später noch einmal." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das stündliche Analyse-Limit ist erreicht. Bitte später noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hourly analysis limit is reached. Please try again later."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La limite horaire d’analyses est atteinte. Réessayez plus tard."
          }
        }
      }
    },
    "Das war der letzte Schritt. Fertig, anrichten!" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das war der letzte Schritt. Fertig, anrichten!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That was the last step. Done, plate up!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’était la dernière étape. Fini, à table !"
          }
        }
      }
    },
    "Datum und Titel kommen aus den Fotos. Steht der Name eines Gerichts im Titel, ist es schon gewählt; sonst wählst Du es je Foto. Ohne Gericht bleibt ein Foto draußen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datum und Titel kommen aus den Fotos. Steht der Name eines Gerichts im Titel, ist es schon gewählt; sonst wählst Du es je Foto. Ohne Gericht bleibt ein Foto draußen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Date and title come from the photos. If a dish's name is in the title, it is already chosen; otherwise choose it per photo. A photo without a dish stays out."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La date et le titre viennent des photos. Si le nom d’un plat figure dans le titre, il est déjà choisi ; sinon, choisissez-le pour chaque photo. Une photo sans plat est ignorée."
          }
        }
      }
    },
    "Dauer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
