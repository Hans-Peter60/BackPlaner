    "Dauer %lld Min., Zeiten ab Minute 0" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dauer %lld Min., Zeiten ab Minute 0"
          }
        },
