    "NSAlarmKitUsageDescription" : {
      "comment" : "Privacy - AlarmKit Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CookPlanner stellt auf Wunsch Wecker für Töpfe und Ofen, die auch bei stummgeschaltetem iPhone klingeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CookPlanner sets alarms for pots and the oven on request, which ring even when the iPhone is on silent."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CookPlanner règle sur demande des alarmes pour les casseroles et le four, qui sonnent même si l’iPhone est en silencieux."
          }
        }
      },
      "extractionState" : "manual"
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CookPlanner fotografiert Rezeptseiten, um ihren Text zu erkennen, und auf Wunsch Deine fertigen Gerichte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CookPlanner photographs recipe pages to recognize their text and, if you like, your finished dishes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CookPlanner photographie des pages de recettes pour en reconnaître le texte et, si vous le souhaitez, vos plats terminés."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Kochmodus hört CookPlanner auf „Erledigt“, „Steht“, „Vorlesen“ und „Was kommt“, damit Du mit nassen Händen durch die Schritte kommst. Die Spracherkennung läuft auf dem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the cook mode CookPlanner listens for “done”, “it's on”, “read” and “what's next”, so you can go through the steps with wet hands. Speech is recognized on the device."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En mode cuisine, CookPlanner écoute « terminé », « c'est parti », « lire » et « et après », pour passer les étapes les mains mouillées. La reconnaissance vocale s’effectue sur l’appareil."
          }
        }
      },
      "comment" : "Privacy - Microphone Usage Description"
    },
    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CookPlanner erkennt die gesprochenen Befehle des Kochmodus auf dem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CookPlanner recognizes the spoken commands of the cook mode on the device."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CookPlanner reconnaît sur l’appareil les commandes vocales du mode cuisine."
          }
        }
      },
      "comment" : "Privacy - Speech Recognition Usage Description"
    }
  },
  "version" : "1.0"
}
