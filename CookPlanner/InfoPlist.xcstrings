    "NSAlarmKitUsageDescription" : {
      "comment" : "Privacy - AlarmKit Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CookPlanner stellt auf Wunsch Wecker für Töpfe und Ofen, die auch bei stummgeschaltetem iPhone klingeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CookPlanner sets alarms for pots and the oven on request, which ring even when the iPhone is on silent."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CookPlanner règle sur demande des alarmes pour les casseroles et le four, qui sonnent même si l’iPhone est en silencieux."
          }
        }
      },
