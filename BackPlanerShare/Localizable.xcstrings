    },
    "BakePlanner ließ sich von hier aus nicht öffnen. Öffne die App selbst, der Import startet dort von allein." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BakePlanner ließ sich von hier aus nicht öffnen. Öffne die App selbst, der Import startet dort von allein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BakePlanner could not be opened from here. Open the app yourself; the import starts there on its own."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’ouvrir BakePlanner d’ici. Ouvrez l’app vous-même, l’import y démarrera tout seul."
          }
        }
      }
    },
    "Die Adresse konnte nicht an BakePlanner übergeben werden." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Adresse konnte nicht an BakePlanner übergeben werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The address could not be handed to BakePlanner."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’adresse n’a pas pu être transmise à BakePlanner."
          }
        }
      }
    },
    "Die Seite wird an BakePlanner übergeben. Dort liest die App Zutaten und Arbeitsschritte aus und zeigt sie Dir vor dem Speichern." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Seite wird an BakePlanner übergeben. Dort liest die App Zutaten und Arbeitsschritte aus und zeigt sie Dir vor dem Speichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The page is handed to BakePlanner. There the app reads out the ingredients and the steps and shows them to you before saving."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La page est transmise à BakePlanner. L’app y extrait les ingrédients et les étapes et vous les montre avant l’enregistrement."
          }
        }
      }
    },
