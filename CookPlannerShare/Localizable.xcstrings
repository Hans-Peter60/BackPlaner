            "value" : "Annuler"
          }
        }
      }
    },
    "CookPlanner ließ sich von hier aus nicht öffnen. Öffne die App selbst, der Import startet dort von allein." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CookPlanner ließ sich von hier aus nicht öffnen. Öffne die App selbst, der Import startet dort von allein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CookPlanner could not be opened from here. Open the app yourself; the import starts there on its own."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CookPlanner n’a pas pu être ouvert d’ici. Ouvrez l’app vous-même, l’importation y démarre toute seule."
          }
        }
      }
    },
    "Die Adresse konnte nicht an CookPlanner übergeben werden." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Adresse konnte nicht an CookPlanner übergeben werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The address could not be handed to CookPlanner."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’adresse n’a pas pu être transmise à CookPlanner."
          }
        }
      }
    },
    "Die Seite wird an CookPlanner übergeben. Dort liest die App die Arbeitsschritte aus, schätzt die Zeiten und zeigt Dir alles vor dem Speichern." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Seite wird an CookPlanner übergeben. Dort liest die App die Arbeitsschritte aus, schätzt die Zeiten und zeigt Dir alles vor dem Speichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The page is handed to CookPlanner. There the app reads the work steps, estimates the times and shows you everything before saving."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La page est transmise à CookPlanner. L’app y lit les étapes, estime les durées et vous montre tout avant l’enregistrement."
          }
        }
      }
    },
