<?xml version="1.0" encoding="utf-8"?>
<!-- Nunito at weight 800, as its own family: Compose does not pick a
     weight out of a Typeface-backed family, so the app names the weight
     it wants (AppFont in Theme.swift). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font android:font="@font/nunito_variable" android:fontWeight="800" android:fontStyle="normal" android:fontVariationSettings="'wght' 800"
        app:font="@font/nunito_variable" app:fontWeight="800" app:fontStyle="normal" app:fontVariationSettings="'wght' 800" />
</font-family>
