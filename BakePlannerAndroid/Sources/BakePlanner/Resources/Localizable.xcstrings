    "Der Plan steht in der Zeitleiste, aber ohne Erinnerungen: BakePlanner darf keine Benachrichtigungen senden. Das lässt sich in den Android-Einstellungen unter Apps ändern." : {
      "comment" : "Planning on Android when notifications are not allowed.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The plan is on the timeline, but without reminders: BakePlanner may not send notifications. You can change this in Android's settings under Apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plan figure dans la chronologie, mais sans rappels : BakePlanner n’a pas le droit d’envoyer des notifications. Vous pouvez le modifier dans les réglages d’Android, sous Applications."
          }
        }
      }
    },
    "Der verschobene Zeitpunkt muss in der Zukunft liegen." : {
      "comment" : "Error description for a time that is in the past.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The rescheduled time must be in the future."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’heure décalée doit se situer dans le futur."
          }
        }
      }
    },
    "Die Änderung konnte nicht gespeichert werden." : {
      "comment" : "Error message when a change could not be saved.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The change could not be saved."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modification n’a pas pu être enregistrée."
          }
        }
      }
    },
    "Die Menge gilt für diese Einkaufsliste. Das Rezept bleibt unverändert." : {
      "comment" : "A description of the effect of changing the amount of a shopping list item.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The amount applies to this shopping list. The recipe stays unchanged."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La quantité s’applique à cette liste de courses. La recette reste inchangée."
          }
        }
      }
    },
    "Die Mengen entsprechen dem Faktor %@." : {
      "comment" : "A message that appears in a ShoppingCartSelectFormView alert, showing the factor by which the recipe's ingredient amounts have been multiplied.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "The amounts correspond to the factor %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les quantités correspondent au facteur %@."
          }
        }
      }
    },
    "Die Rezepte konnten nicht geladen werden." : {
      "comment" : "When the recipe database cannot be read.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The recipes could not be loaded."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les recettes n’ont pas pu être chargées."
          }
        }
      }
    },
    "Dieser Schritt und alle späteren Schritte desselben Plans werden um dieselbe Zeit verschoben." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This step and every later step of the same plan move by the same amount."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette étape et toutes les étapes suivantes du même plan sont décalées de la même durée."
          }
        }
      }
    },
    "Du kannst den bestehenden Plan ersetzen oder beide behalten – etwa für zwei Backtage." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can replace the existing plan or keep both — for two baking days, say."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez remplacer le plan existant ou garder les deux — pour deux jours de cuisson, par exemple."
          }
        }
      }
    },
