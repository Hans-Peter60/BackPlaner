    "Blockierte Autoren" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocked authors"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auteurs bloqués"
          }
        }
      }
    },
    "Blockierte Autoren erscheinen sofort wieder in der Rezept-Datenbank. Ein gemeldetes Rezept bleibt dagegen für alle Nutzer ausgeblendet, bis ein Administrator es geprüft hat — das Zurücknehmen wirkt erst danach." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authors you unblock reappear in the recipe database right away. A reported recipe, however, stays hidden from all users until an administrator has reviewed it — clearing it here only takes effect after that."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les auteurs que vous débloquez réapparaissent immédiatement dans la base de recettes. En revanche, une recette signalée reste masquée pour tous les utilisateurs jusqu’à ce qu’un administrateur l’ait examinée : l’effacement ne prend effet qu’après."
          }
        }
      }
    },
    "Blockierungen aufheben" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unblock all authors"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Débloquer tous les auteurs"
          }
        }
      }
    },
    "Cloud-KI" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
