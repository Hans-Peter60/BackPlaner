    "Vollkorn braucht Zeit zum Quellen: Autolyse oder ein Brüh-/Quellstück einplanen; die Krume wird dichter." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wholegrain needs time to hydrate: allow an autolyse or a scald or soaker; the crumb turns denser."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La farine complète a besoin de temps pour s’hydrater : prévoyez une autolyse, un échaudage ou un trempage ; la mie sera plus dense."
          }
        }
      }
    },
