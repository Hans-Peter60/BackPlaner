    "Festeres Anstellgut (niedrigere TA) arbeitet langsamer und säuert kräftiger – etwas mehr Reifezeit einplanen." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A firmer starter (lower TA) works more slowly and sours more strongly – allow a little more ripening time."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un levain chef plus ferme (TA plus basse) travaille plus lentement et acidifie davantage – prévoyez un peu plus de temps de maturation."
          }
        }
      }
    },
    "Formen" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
