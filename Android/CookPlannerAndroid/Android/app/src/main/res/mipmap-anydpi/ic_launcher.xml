<?xml version="1.0" encoding="utf-8"?>
<!-- The iPhone's app icon as an adaptive icon (scripts/cookplanner/android-icon.swift):
     the picture at 80 % of the canvas, so the pan stays inside the
     launcher's mask, on black, the icon's edge colour. No monochrome layer:
     the picture has no flat silhouette, so a themed launcher shows the
     normal icon. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
