<?xml version="1.0" encoding="utf-8"?>
<!-- Where the camera may write the photo it takes for a cooking record:
     the Pictures folder of the app's external files (SkipKit's media
     picker creates the file there and hands the camera a content:// address
     of the FileProvider in the manifest). -->
<paths>
    <external-files-path name="pictures" path="Pictures/" />
    <!-- Files the app hands to other apps (the plan and the yearbook as PDF). -->
    <cache-path name="shared" path="shared/" />
</paths>
