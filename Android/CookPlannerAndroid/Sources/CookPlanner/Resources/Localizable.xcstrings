    "Hände frei, der Topf braucht noch" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hands free, the pot needs a little longer"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mains libres, la casserole a encore besoin de temps"
          }
        }
      }
    },
    "Hände frei, in %lld Min. weiter" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hands free, next in %lld min"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mains libres, suite dans %lld min"
          }
        }
      }
    },
    "Hände: %lld Min." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hands: %lld min"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mains : %lld min"
          }
        }
      }
    },
    "Hände: Minuten, in denen der Koch gebunden ist. Danach allein: kochen, backen, ruhen ohne Koch." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hands: minutes the cook is tied up. Then on its own: cooking, baking, resting without the cook."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mains : minutes où le cuisinier est occupé. Ensuite seul : cuisson, four, repos sans cuisinier."
          }
        }
      }
    },
    "Herd" : {
