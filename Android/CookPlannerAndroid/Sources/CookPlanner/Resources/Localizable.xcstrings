      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chain %lld min"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaîne %lld min"
          }
        }
      }
    },
    "Kette (%lld Minuten) und Hände (%lld Minuten) passen einzeln, kollidieren aber an Händen oder Geräten." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chain (%lld minutes) and hands (%lld minutes) fit on their own but collide on the hands or the stations."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chaîne (%lld minutes) et les mains (%lld minutes) tiennent séparément mais se heurtent aux mains ou aux postes."
          }
        }
      }
    },
