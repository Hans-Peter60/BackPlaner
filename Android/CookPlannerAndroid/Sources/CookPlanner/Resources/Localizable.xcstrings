      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chain %lld min"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaîne %lld min"
          }
        }
      }
    },
    "Kette (%lld Minuten) und Hände (%lld Minuten) passen einzeln, kollidieren aber an Händen oder Geräten." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
