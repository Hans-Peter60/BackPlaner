    },
    "Hände: Minuten, in denen der Koch gebunden ist. Danach allein: kochen, backen, ruhen ohne Koch." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hands: minutes the cook is tied up. Then on its own: cooking, baking, resting without the cook."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mains : minutes où le cuisinier est occupé. Ensuite seul : cuisson, four, repos sans cuisinier."
          }
        }
      }
    },
