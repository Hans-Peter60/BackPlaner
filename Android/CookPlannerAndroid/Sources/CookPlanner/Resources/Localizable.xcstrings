    "Dauer %lld Min., Zeiten ab Minute 0" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld min, times from minute 0"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durée %lld min, temps depuis la minute 0"
          }
        }
      }
    },
    "Der Analyse-Dienst hat die Anfrage nicht zugelassen. Bitte die App aktualisieren oder später noch einmal versuchen." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The analysis service did not allow the request. Please update the app or try again later."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le service d’analyse n’a pas accepté la demande. Mettez l’app à jour ou réessayez plus tard."
          }
        }
      }
    },
    "Der Mittelwert (Median) der abgehakten Zeiten aus den letzten bis zu fünf Durchgängen. Bei Töpfen und Ofenschritten bleibt die Handarbeit, die Zeit allein passt sich an." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The median of the ticked times from the latest five runs at most. For pots and oven steps the hands-on time stays and the unattended time adapts."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La médiane des temps cochés sur au plus les cinq derniers passages. Pour les casseroles et le four, le temps manuel reste et le temps seul s’adapte."
          }
        }
      }
    },
    "Der Plan geht nicht auf." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The plan does not work out."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plan ne tient pas."
