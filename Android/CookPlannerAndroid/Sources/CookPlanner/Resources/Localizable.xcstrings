    "Das Gericht braucht eine Herdplatte; in den Einstellungen steht die Küche auf 0 Platten." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The dish needs a burner; the kitchen in the settings has 0 burners."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plat a besoin d’un feu ; la cuisine des réglages compte 0 feu."
          }
        }
      }
    },
    "Das Gericht braucht einen Ofen; in den Einstellungen steht die Küche auf 0 Öfen." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The dish needs an oven; the kitchen in the settings has 0 ovens."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plat a besoin d’un four ; la cuisine des réglages compte 0 four."
          }
        }
      }
    },
    "Der Plan geht nicht auf." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The plan does not work out."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plan ne tient pas."
          }
        }
      }
    },
    "Die Handarbeit allein dauert %lld Minuten. Eine Person reicht nicht: Schritte streichen oder vereinfachen." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hands-on work alone takes %lld minutes. One pair of hands is not enough: drop or simplify steps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le travail manuel seul prend %lld minutes. Une seule personne ne suffit pas : supprimez ou simplifiez des étapes."
          }
        }
      }
    },
    "Die längste Kette dauert %lld Minuten. Parallel arbeiten hilft nicht, nur kürzere Schritte." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The longest chain takes %lld minutes. Working in parallel does not help, only shorter steps do."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chaîne la plus longue dure %lld minutes. Travailler en parallèle n’aide pas, seules des étapes plus courtes le font."
          }
        }
      }
    },
    "Die Öfen sind vorgeheizt, wenn die Uhr startet." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The ovens are preheated when the clock starts."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fours sont préchauffés quand le chrono démarre."
          }
        }
      }
    },
    "Die Schritte warten im Kreis aufeinander. Die Reihenfolge der Schritte prüfen." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The steps wait for one another in a circle. Check the order of the steps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les étapes s’attendent en boucle. Vérifiez l’ordre des étapes."
          }
        }
      }
    },
    "Ein Gericht, eine Person, %lld Minuten" : {
