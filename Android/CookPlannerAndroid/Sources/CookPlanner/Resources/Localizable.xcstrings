          }
        }
      }
    },
    "Das Protokoll hält fest, wann jeder Schritt erledigt war." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The record keeps when each step was done."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le relevé garde le moment où chaque étape a été terminée."
          }
        }
      }
    },
    "Das stündliche Analyse-Limit ist erreicht. Bitte später noch einmal." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hourly analysis limit is reached. Please try again later."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La limite horaire d’analyses est atteinte. Réessayez plus tard."
          }
        }
      }
    },
    "Das war der letzte Schritt. Fertig, anrichten!" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That was the last step. Done, plate up!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’était la dernière étape. Fini, à table !"
          }
        }
      }
    },
    "Das war die letzte kostenlose Rezeptanalyse dieses Monats. Mit CookPlanner Pro gibt es keine Monatsgrenze." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That was this month’s last free recipe analysis. With CookPlanner Pro there is no monthly limit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’était la dernière analyse de recette gratuite de ce mois. Avec CookPlanner Pro, il n’y a pas de limite mensuelle."
          }
        }
      }
    },
    "Dauer" : {
      "extractionState" : "manual",
      "localizations" : {
