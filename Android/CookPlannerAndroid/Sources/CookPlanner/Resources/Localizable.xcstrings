    "Hake ab, was Du schon im Haus hast. Den Rest teilst Du unten, z. B. an Erinnerungen." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tick what you already have at home. Share the rest below, for example to Reminders."
          }
        },
