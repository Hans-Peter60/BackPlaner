      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At most %lld min"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au plus %lld min"
          }
        }
      }
    },
    "in %lld Min." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "in %lld min"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dans %lld min"
          }
        }
      }
    },
    "Jeder Schritt wartet nur auf die Schritte, die bei ihm angegeben sind; ohne Angabe kann er sofort beginnen." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A step waits only for the steps named on it; without any it can start right away."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une étape n’attend que les étapes indiquées pour elle ; sans indication, elle peut commencer tout de suite."
          }
        }
      }
    },
    "Jetzt" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Now"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenant"
          }
        }
      }
    },
    "Jetzt dran" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Up now"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À faire maintenant"
          }
        }
      }
    },
    "Keine Uhr, kein Überfällig: Die Schritte kommen der Reihe nach, nur Topf und Ofen behalten ihre Zeit." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No clock, nothing overdue: the steps come in their order; only pots and the oven keep their time."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas d’horloge, rien en retard : les étapes viennent dans l’ordre, seuls les casseroles et le four gardent leur temps."
          }
        }
      }
    },
    "Keins" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "None"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun"
          }
        }
      }
    },
