    "Das Buch nimmt alle Kochvorgänge des Jahres mit ihren Fotos, die Lieblingsgerichte und was die Uhr gelehrt hat." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The book takes every cooking session of the year with its photos, the favourite dishes and what the clock taught."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le livre reprend toutes les sessions de l’année avec leurs photos, les plats préférés et ce que l’horloge a appris."
          }
        }
      }
    },
    "Das Gericht braucht eine Herdplatte; in den Einstellungen steht die Küche auf 0 Platten." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The dish needs a burner; the kitchen in the settings has 0 burners."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plat a besoin d’un feu ; la cuisine des réglages compte 0 feu."
          }
        }
      }
    },
